 "log.lookDiscarded": "{who} {card} ഉപയോഗിച്ചു: മുകളിലെ കാർഡ് നോക്കി ഉപേക്ഷിച്ചു",
 "reveal.lookBought": "{who} മുകളിലെ കാർഡ് നോക്കി വാങ്ങി (3 M€)",
 "help.map2d": "<b>ഭൂപടം</b><br>വിശദാംശങ്ങൾക്കായി ഒരു ഷഡ്ഭുജം ടാപ്പ് ചെയ്യുക അല്ലെങ്കിൽ മുകളിൽ കൊണ്ടുവരുക · സൂം ചെയ്യാൻ വീൽ / പിഞ്ച് · സൂം ചെയ്ത ശേഷം നീക്കാൻ വലിക്കുക · ബോർഡ് ഒതുക്കാൻ ഡബിൾ-ക്ലിക്ക് (അല്ലെങ്കിൽ H).",
 "menu.autoconf": "ഊഴങ്ങൾ സ്വയം സ്ഥിരീകരിക്കുക (പഴയപടിയാക്കാൻ കാത്തുനിൽക്കില്ല)",
 "menu.think": "TFMBot-ന്റെ തിരച്ചിൽ രേഖയിൽ കാണിക്കുക",
 "menu.thinkWarn": "(അത് എന്തൊക്കെ പരിഗണിച്ചു, എത്ര ഉറപ്പായിരുന്നു — ഇത് അതിന്റെ കൈയിലെ കാർഡുകൾ വെളിപ്പെടുത്തിയേക്കാം)",
 "menu.music": "സംഗീത ശബ്ദം",
 "menu.sfx": "ഇഫക്റ്റ് ശബ്ദം",
 "menu.lang": "ഭാഷ",
 "menu.auto": "എന്റെ നീക്കം ബോട്ട് കളിക്കട്ടെ",
 "menu.autoTitle": "നിങ്ങളുടെ ഇപ്പോഴത്തെ തീരുമാനം TFMBot എടുക്കട്ടെ",
 "menu.fine": "നിയമ എഞ്ചിൻ: tfmc (C → WebAssembly) നിങ്ങളുടെ ബ്രൗസറിൽ. TFMBot: ഇപ്പോഴത്തെ ചാമ്പ്യൻ, സെർവറിൽ നേരിട്ട് പ്രവർത്തിക്കുന്നു. FryxGames, Asmodee Digital, Steam എന്നിവയുമായി ബന്ധമില്ല.",
 "help.title": "ഇവിടെ എങ്ങനെ കളിക്കാം",
 "help.globe": "<b>ഗോളം</b><br>തിരിക്കാൻ വലിക്കുക · സൂം ചെയ്യാൻ വീൽ / പിഞ്ച് · നീക്കാൻ രണ്ട് വിരൽ അല്ലെങ്കിൽ റൈറ്റ്-ഡ്രാഗ് · മധ്യത്തിലാക്കാൻ ഡബിൾ-ക്ലിക്ക് (അല്ലെങ്കിൽ H).",
 "help.turn": "<b>നിങ്ങളുടെ ഊഴം</b><br>കൈയിൽ തിളങ്ങുന്ന കാർഡുകൾ കളിക്കാം — വായിച്ച് കളിക്കാൻ ഒന്നിൽ ക്ലിക്ക് ചെയ്യുക. അടിസ്ഥാന പദ്ധതികൾ, കാർഡ് പ്രവർത്തനങ്ങൾ, നാഴികക്കല്ലുകൾ, പുരസ്കാരങ്ങൾ എന്നിവ വലതുവശത്താണ്.",
 "help.tiles": "<b>ടൈലുകൾ സ്ഥാപിക്കൽ</b><br>സ്ഥാപിക്കാവുന്ന ഷഡ്ഭുജങ്ങൾ സ്വർണ്ണ നിറത്തിൽ തിളങ്ങും. ടൈലിന്റെ മുൻകാഴ്ചയും ആ സ്ഥലം നൽകുന്നതും കാണാൻ മുകളിൽ കൊണ്ടുവരുക.",
 "help.undo": "<b>പഴയപടിയാക്കുക</b><br>ഒരു കാർഡ് വെളിപ്പെടും വരെ എന്തും പഴയപടിയാക്കാം. ഊഴം തീരുമ്പോൾ <i>ഊഴം സ്ഥിരീകരിക്കുക</i> വരും — നിങ്ങൾ സ്ഥിരീകരിക്കും വരെ ഒന്നും TFMBot-ൽ എത്തില്ല. <kbd>Ctrl+Z</kbd> പഴയപടി · <kbd>Enter</kbd> സ്ഥിരീകരിക്കുക · <kbd>Esc</kbd> റദ്ദാക്കുക.",
 "help.opp": "<b>എതിരാളി</b><br>ഒരു കളിക്കാരന്റെ ബോർഡിന് മുകളിൽ മൗസ് കൊണ്ടുവന്ന് (അല്ലെങ്കിൽ അമർത്തിപ്പിടിച്ച്) അവരുടെ മേശ കാണുക. ഇടതുവശത്തെ പട്ടിക TFMBot-ന്റെ ഓരോ നീക്കവും അത് മറ്റെന്തൊക്കെ പരിഗണിച്ചുവെന്നും കാണിക്കുന്നു; മുകളിലെ ബാർ നിങ്ങളുടെ വിജയ സാധ്യതയെക്കുറിച്ചുള്ള അതിന്റെ കണക്ക് കാണിക്കുന്നു.",
 "help.tracks": "<b>ട്രാക്കുകൾ</b><br>താപനില: −24, −20 എന്നിവയിൽ താപ-ഉൽപ്പാദന ബോണസ്, 0 °C-ൽ ഒരു സമുദ്രം. ഓക്സിജൻ: 8%-ൽ +1 താപനില. സമുദ്രങ്ങൾ: 9 സ്ഥാനങ്ങൾ.",
 "help.hint": "<b>💡 സൂചന</b><br>നിങ്ങളുടെ സ്ഥാനത്ത് TFMBot എന്ത് കളിക്കുമെന്ന്, അതിന്റെ മുൻനിര ഓപ്ഷനുകളുടെ തിരച്ചിൽ പങ്കോടെ ചോദിക്കുന്നു.",
