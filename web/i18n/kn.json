 "menu.lang": "ಭಾಷೆ",
 "menu.auto": "ನನ್ನ ನಡೆಯನ್ನು ಬಾಟ್ ಆಡಲಿ",
 "menu.autoTitle": "ನಿಮ್ಮ ಈಗಿನ ನಿರ್ಧಾರವನ್ನು TFMBot ತೆಗೆದುಕೊಳ್ಳಲಿ",
 "menu.fine": "ನಿಯಮ ಎಂಜಿನ್: tfmc (C → WebAssembly) ನಿಮ್ಮ ಬ್ರೌಸರ್‌ನಲ್ಲಿ. TFMBot: ಈಗಿನ ಚಾಂಪಿಯನ್, ಸರ್ವರ್‌ನಲ್ಲಿ ನೇರವಾಗಿ ಚಲಿಸುತ್ತದೆ. FryxGames, Asmodee Digital ಅಥವಾ Steam ಜೊತೆ ಸಂಬಂಧವಿಲ್ಲ.",
 "help.title": "ಇಲ್ಲಿ ಹೇಗೆ ಆಡುವುದು",
 "help.globe": "<b>ಗೋಳ</b><br>ತಿರುಗಿಸಲು ಎಳೆಯಿರಿ · ಜೂಮ್‌ಗೆ ವೀಲ್ / ಪಿಂಚ್ · ಸರಿಸಲು ಎರಡು ಬೆರಳು ಅಥವಾ ರೈಟ್-ಡ್ರ್ಯಾಗ್ · ಮಧ್ಯಕ್ಕೆ ತರಲು ಡಬಲ್-ಕ್ಲಿಕ್ (ಅಥವಾ H).",
 "help.turn": "<b>ನಿಮ್ಮ ಸರದಿ</b><br>ಕೈಯಲ್ಲಿ ಹೊಳೆಯುವ ಕಾರ್ಡ್‌ಗಳನ್ನು ಆಡಬಹುದು — ಓದಿ ಆಡಲು ಒಂದನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ. ಪ್ರಮಾಣಿತ ಯೋಜನೆಗಳು, ಕಾರ್ಡ್ ಕ್ರಿಯೆಗಳು, ಮೈಲಿಗಲ್ಲುಗಳು ಮತ್ತು ಪ್ರಶಸ್ತಿಗಳು ಬಲಭಾಗದಲ್ಲಿವೆ.",
 "help.tiles": "<b>ಟೈಲ್ ಇರಿಸುವುದು</b><br>ಇರಿಸಬಹುದಾದ ಷಡ್ಭುಜಗಳು ಚಿನ್ನದ ಬಣ್ಣದಲ್ಲಿ ಹೊಳೆಯುತ್ತವೆ. ಟೈಲ್‌ನ ಮುನ್ನೋಟ ಮತ್ತು ಆ ಜಾಗ ಏನು ನೀಡುತ್ತದೆ ಎಂದು ನೋಡಲು ಮೇಲೆ ತನ್ನಿ.",
 "help.undo": "<b>ರದ್ದುಗೊಳಿಸಿ</b><br>ಕಾರ್ಡ್ ತೆರೆಯುವವರೆಗೆ ಏನನ್ನಾದರೂ ರದ್ದುಗೊಳಿಸಬಹುದು. ಸರದಿ ಮುಗಿದಾಗ <i>ಸರದಿ ದೃಢೀಕರಿಸಿ</i> ಬರುತ್ತದೆ — ನೀವು ದೃಢೀಕರಿಸುವವರೆಗೆ ಏನೂ TFMBot ತಲುಪುವುದಿಲ್ಲ. <kbd>Ctrl+Z</kbd> ರದ್ದುಗೊಳಿಸಿ · <kbd>Enter</kbd> ದೃಢೀಕರಿಸಿ · <kbd>Esc</kbd> ರದ್ದುಮಾಡಿ.",
 "help.opp": "<b>ಎದುರಾಳಿ</b><br>ಆಟಗಾರನ ಬೋರ್ಡ್ ಮೇಲೆ ಮೌಸ್ ತನ್ನಿ (ಅಥವಾ ಒತ್ತಿ ಹಿಡಿಯಿರಿ) ಮತ್ತು ಅವರ ಟೇಬಲ್ ನೋಡಿ. ಎಡಭಾಗದ ಪಟ್ಟಿ TFMBot ನ ಪ್ರತಿ ನಡೆಯನ್ನೂ ಅದು ಇನ್ನೇನು ಪರಿಗಣಿಸಿತು ಎಂಬುದನ್ನೂ ತೋರಿಸುತ್ತದೆ; ಮೇಲಿನ ಪಟ್ಟಿ ನಿಮ್ಮ ಗೆಲುವಿನ ಸಾಧ್ಯತೆಯ ಅದರ ಅಂದಾಜನ್ನು ತೋರಿಸುತ್ತದೆ.",
 "help.tracks": "<b>ಟ್ರ್ಯಾಕ್‌ಗಳು</b><br>ತಾಪಮಾನ: −24 ಮತ್ತು −20 ರಲ್ಲಿ ಶಾಖ-ಉತ್ಪಾದನೆ ಬೋನಸ್, 0 °C ನಲ್ಲಿ ಒಂದು ಸಾಗರ. ಆಮ್ಲಜನಕ: 8% ನಲ್ಲಿ +1 ತಾಪಮಾನ. ಸಾಗರಗಳು: 9 ಸ್ಥಳಗಳು.",
 "help.hint": "<b>💡 ಸುಳಿವು</b><br>ನಿಮ್ಮ ಸ್ಥಾನದಲ್ಲಿ TFMBot ಏನು ಆಡುತ್ತದೆ ಎಂದು, ಅದರ ಮುಖ್ಯ ಆಯ್ಕೆಗಳ ಹುಡುಕಾಟ ಪಾಲಿನೊಂದಿಗೆ ಕೇಳುತ್ತದೆ.",
