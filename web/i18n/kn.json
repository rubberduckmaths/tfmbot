 "crit.card_resources:animal+microbe": "ಕಾರ್ಡ್‌ಗಳ ಮೇಲಿನ ಪ್ರಾಣಿಗಳು + ಸೂಕ್ಷ್ಮಜೀವಿಗಳು",
 "crit.tags:jovian+earth": "ಗುರು + ಭೂಮಿ ಟ್ಯಾಗ್‌ಗಳು",
 "crit.largest_contiguous_tiles": "ನಿಮ್ಮ ಟೈಲ್‌ಗಳ ಅತಿದೊಡ್ಡ ಗುಂಪು",
 "crit.tiles_not_adjacent_ocean": "ಸಾಗರದ ಪಕ್ಕದಲ್ಲಿಲ್ಲದ ಟೈಲ್‌ಗಳು",
 "crit.prod:steel+titanium": "ಉಕ್ಕು + ಟೈಟಾನಿಯಂ ಉತ್ಪಾದನೆ",
 "lore.Noctis City": "ನಾಕ್ಟಿಸ್ ಲ್ಯಾಬಿರಿಂಥಸ್‌ನ ಆಳದಲ್ಲಿ, ಕಿಲೋಮೀಟರ್ ಎತ್ತರದ ಕಣಿವೆ ಗೋಡೆಗಳು ಕಾಸ್ಮಿಕ್ ಕಿರಣಗಳಿಂದ ರಕ್ಷಿಸುವ ಜಾಗದಲ್ಲಿ, ಮೊದಲ ವಸಾಹತುಗಾರರು ನಗರಕ್ಕೆ ಸೂಕ್ತ ಸ್ಥಳವನ್ನು ಕಂಡುಕೊಂಡರು.",
 "lore.Tharsis Tholus": "ಶಿಖರ ಕುಸಿದ ಒಂದು ಹಳೆಯ ಗುರಾಣಿ ಜ್ವಾಲಾಮುಖಿ. ಅದರ ಲಾವಾ ಕೊಳವೆಗಳೇ ಥಾರ್ಸಿಸ್ ಸಮೀಕ್ಷಾ ತಂಡಗಳ ಮೊದಲ ಆಶ್ರಯಗಳಾಗಿದ್ದವು; ಇಂದಿಗೂ ಅವುಗಳಲ್ಲಿ ಗಾಳಿ ಪಂಖಗಳು ಗುನುಗುತ್ತವೆ.",
 "lore.Ascraeus Mons": "ಥಾರ್ಸಿಸ್‌ನ ಮೂವರು ದೈತ್ಯರಲ್ಲಿ ಅತ್ಯಂತ ಉತ್ತರದ್ದು, 18 ಕಿ.ಮೀ. ಎತ್ತರ. ಅದರ ಶಿಖರ ಕುಳಿಯಲ್ಲೇ ಮೊದಲ ಕಕ್ಷೀಯ ಎಲಿವೇಟರ್ ಸಮೀಕ್ಷೆಯಾಗಿ ನಂತರ ಕೈಬಿಡಲಾಯಿತು.",
 "lore.Pavonis Mons": "ಬಹುತೇಕ ನಿಖರವಾಗಿ ಸಮಭಾಜಕದ ಮೇಲೆ ಕುಳಿತಿರುವ \"ನವಿಲು ಪರ್ವತ\" ಬಾಹ್ಯಾಕಾಶ ಎಲಿವೇಟರ್‌ಗೆ ಸಹಜ ಲಂಗರು; ಅದರ ಇಳಿಜಾರಿನ ಸಮೀಕ್ಷಾ ದೀಪಗಳು ಇನ್ನೂ ಮಿನುಗುತ್ತವೆ.",
 "lore.Arsia Mons": "ಬೆಳಗಿನ ಮೋಡಗಳಿಂದ ಸುತ್ತುವರಿದ ದಕ್ಷಿಣ ಥಾರ್ಸಿಸ್ ಜ್ವಾಲಾಮುಖಿ. ಅದರ ಕುಳಿ ಈ ಪ್ರದೇಶದ ಅತ್ಯಂತ ಹಳೆಯ ಹಿಮ ನಿಕ್ಷೇಪಗಳನ್ನು ಕಾಪಾಡುತ್ತದೆ; ಮೊದಲ ಜಲಹಕ್ಕು ಸನ್ನದಿನಿಂದಲೂ ಅವಕ್ಕಾಗಿ ಜಗಳ ನಡೆಯುತ್ತಿದೆ.",
 "lore.Ganymede Colony": "ಗುರುವಿನ ಅತಿದೊಡ್ಡ ಚಂದ್ರ, ಬುಧನಿಗಿಂತಲೂ ದೊಡ್ಡದು. ವಸಾಹತು ಹೊಳೆಯುವ ಗೀರುಗಳ ಭೂಭಾಗದಲ್ಲಿದೆ; ಒಳ ಸೌರವ್ಯೂಹದೊಂದಿಗೆ ನೀರಿನ ಹಿಮ ಮತ್ತು ತಾಳ್ಮೆಯ ವ್ಯಾಪಾರ ಮಾಡುತ್ತದೆ.",
 "lore.Phobos Space Haven": "ಮಂಗಳದ ಒಳ ಚಂದ್ರ, ಮೇಲ್ಮೈಯಿಂದ 6,000 ಕಿ.ಮೀ. ಎತ್ತರದಲ್ಲಿ ಜಾರುತ್ತಾ ಸುತ್ತುತ್ತದೆ. ಟೊಳ್ಳು ಮಾಡಿದ ಅದರ ಸ್ಟಿಕ್ನಿ ಕುಳಿ ಮಂಗಳ ಮತ್ತು ಕ್ಷುದ್ರಗ್ರಹ ಪಟ್ಟಿಯ ನಡುವಿನ ಅತ್ಯಂತ ಜನನಿಬಿಡ ಬಂದರಾಯಿತು.",
 "lore.Elysium Mons": "ಪೂರ್ವದ ಮಹಾ ಜ್ವಾಲಾಮುಖಿ, 12 ಕಿ.ಮೀ. ಎತ್ತರ ಮತ್ತು ಕೆಲವು ದಶಲಕ್ಷ ವರ್ಷಗಳಿಂದ ಶಾಂತ. ಶಿಖರ ಇರಬೇಕಾದುದಕ್ಕಿಂತ ಬೆಚ್ಚಗಿದೆ ಎಂದು ಸಮೀಕ್ಷಕರು ಆಣೆ ಮಾಡುತ್ತಾರೆ; ಭೂಶಾಖ ಒಕ್ಕೂಟ ವಿನಯದಿಂದ ಪ್ರತಿಕ್ರಿಯಿಸಲು ನಿರಾಕರಿಸುತ್ತದೆ.",
 "lore.Hecates Tholus": "ಕೂಡುರಸ್ತೆಗಳ ಮತ್ತು ರಾತ್ರಿಯ ದೇವತೆಯ ಹೆಸರಿನದು. ಅದರ ಇಳಿಜಾರುಗಳನ್ನು ಹಳೆಯ ಹಿಮನದಿಗಳು ಕೆತ್ತಿವೆ; ಅಲ್ಲಿ ಕೆಲಸ ಮಾಡುವ ಹಿಮ ಗಣಿಗಾರರು ಅದೃಷ್ಟಕ್ಕಾಗಿ ಕುಳಿಯ ಅಂಚಿನಲ್ಲಿ ಒಂದು ಲಾಂದ್ರವನ್ನು ಉರಿಸಿಡುತ್ತಾರೆ.",
 "lore.Olympus Mons": "ಸೌರವ್ಯೂಹದ ಅತಿ ಎತ್ತರದ ಜ್ವಾಲಾಮುಖಿ: 22 ಕಿ.ಮೀ. ಎತ್ತರ ಮತ್ತು ಫ್ರಾನ್ಸ್‌ನಷ್ಟು ಅಗಲ. ಶಿಖರದಿಂದ ದಿಗಂತ ಎಷ್ಟು ದೂರವೆಂದರೆ ನೀವು ಪರ್ವತದ ಮೇಲಿದ್ದೀರಿ ಎಂದೇ ಗೊತ್ತಾಗುವುದಿಲ್ಲ. ಆದರೂ ಮೂರು ವಾರಗಳ ಚಾರಣಕ್ಕೆ ಆ ನೋಟ ಯೋಗ್ಯ.",
 "lore.South Pole": "ಋತುಮಾನದ ಒಣ ಹಿಮಟೊಪ್ಪಿಯ ಕೆಳಗೆ ಪದರ ಪದರವಾಗಿ ನೀರಿನ ಹಿಮ. ಪ್ರತಿ ವಸಂತದಲ್ಲಿ CO₂ ಕಪ್ಪು ಬುಗ್ಗೆಗಳಾಗಿ ಆವಿಯಾಗುತ್ತದೆ; ಸ್ಥಳೀಯರು ಅವನ್ನು \"ಜೇಡಗಳು\" ಎನ್ನುತ್ತಾರೆ ಮತ್ತು ಪ್ರವಾಸಿಗರು ನೋಡಲು ಒಳ್ಳೆಯ ಹಣ ತೆರುತ್ತಾರೆ.",
 "lore.Alba Mons": "ಮಂಗಳದ ಅತ್ಯಂತ ಅಗಲವಾದ ಜ್ವಾಲಾಮುಖಿ, 1,000 ಕಿ.ಮೀ.ಗೂ ಹೆಚ್ಚು ಹರಡಿದ್ದರೂ ಕೇವಲ 7 ಕಿ.ಮೀ. ಎತ್ತರ. ಗಮನಿಸದೆಯೇ ಹತ್ತಬಹುದಾದ ಪರ್ವತ — ಇದನ್ನು ಆಲ್ಬಾ ಬೆಟ್ಟ-ನಡಿಗೆ ಸಂಘ ಒಂದು ವೈಶಿಷ್ಟ್ಯವೆಂದು ಪರಿಗಣಿಸುತ್ತದೆ.",
 "lore.Uranius Tholus": "ತನ್ನ ಅಣ್ಣ ಯುರೇನಿಯಸ್ ಮಾನ್ಸ್‌ನ ಮರೆಯಲ್ಲಿ ಕುಳಿತಿರುವ ಸಣ್ಣ, ಕಡಿದಾದ ಗುರಾಣಿ ಜ್ವಾಲಾಮುಖಿ. ಉತ್ತರ ಬಯಲುಗಳ ಮೊದಲ ಸ್ವಯಂಚಾಲಿತ ಹವಾಮಾನ ಕೇಂದ್ರವನ್ನು ಅದರ ಶಿಖರಕ್ಕೆ ಬಿಗಿಯಲಾಯಿತು; ಅದು ಇಂದಿಗೂ ಪ್ರತಿ ಗಂಟೆಗೆ ಮುನ್ಸೂಚನೆ ಕಳುಹಿಸುತ್ತದೆ: ಧೂಳು.",
 "lore.Viking 1": "ಮಂಗಳದ ಮೇಲ್ಮೈಯಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸಿದ ಮೊದಲ ನೌಕೆ ವೈಕಿಂಗ್ 1 ಇಳಿದ ಸ್ಥಳ (1976). ಲ್ಯಾಂಡರ್ ಸುತ್ತ ಪರಂಪರೆ ತಾಣವಾಗಿ ಬೇಲಿ ಹಾಕಲಾಗಿದೆ; ಪ್ರತಿ ಹೊಸ ವಸಾಹತುಗಾರನೂ ಬಾಗಿಲಲ್ಲಿ ಒಂದು ಬೆಣಚುಕಲ್ಲು ಇಡಬೇಕು.",
 "lore.Viking 2": "1976 ರಲ್ಲಿ ವೈಕಿಂಗ್ 2 ಯುಟೋಪಿಯಾ ಪ್ಲಾನಿಷಿಯಾದಲ್ಲಿ ಇಳಿದು ಬಂಡೆಗಳ ಮೇಲಿನ ಇಬ್ಬನಿಯನ್ನು ಚಿತ್ರಿಸಿದ ಸ್ಥಳ. ಲ್ಯಾಂಡರ್ ಸುತ್ತ ವಸಾಹತು ಬೆಳೆಯಿತು; ಈಗ ಪ್ರತಿ ಚಳಿಗಾಲದಲ್ಲಿ ಆ ಇಬ್ಬನಿಯನ್ನು ಬಹಳ ತಣ್ಣನೆಯ ಸೂಪ್ ಹಬ್ಬದೊಂದಿಗೆ ಆಚರಿಸಲಾಗುತ್ತದೆ.",
 "lore.North Pole": "ಸುಮಾರು 3 ಕಿ.ಮೀ. ದಪ್ಪದ ನೀರಿನ ಹಿಮಟೊಪ್ಪಿ, ಗಾಳಿ ಕೆತ್ತಿದ ಸುರುಳಿ ಕಣಿವೆಗಳ ಗೆರೆಗಳೊಂದಿಗೆ. ಸಾಗರ ಎಂಜಿನಿಯರ್‌ಗಳು ಅದನ್ನು \"ಜಲಾಶಯ\" ಎನ್ನುತ್ತಾರೆ — ನಿಜವಾಗಿಯೂ.",
 "space.Noctis City": "ನಾಕ್ಟಿಸ್ ನಗರ",
